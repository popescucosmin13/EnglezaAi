VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Variabile private pentru Vercel Functions (NU folosi prefixul VITE_)
FIREBASE_PROJECT_ID=
# Service Account Firebase Admin — necesar pentru generarea linkurilor de verificare/resetare.
FIREBASE_CLIENT_EMAIL=
# În Vercel cheia privată poate folosi secvențe \\n; codul le convertește automat.
FIREBASE_PRIVATE_KEY=
# Opțional, dar recomandat pentru proiect personal: permite numai UID-ul tău Firebase
ALLOWED_FIREBASE_UID=
# UID-urile admin separate prin virgulă; adminii pot schimba planurile și nu au cote zilnice.
ADMIN_FIREBASE_UID=
# UID-uri Firebase separate prin virgulă care pot ocoli numai verificarea emailului
# (de exemplu contul reutilizabil Google Play Review). Nu acordă drepturi admin.
EMAIL_VERIFICATION_BYPASS_UIDS=
OPENROUTER_API_KEY=
# Jev folosește aceeași cheie OpenRouter. Implicit off; shadow măsoară fără să modifice răspunsul.
JEV_ROUTER_MODE=off
# Modele suplimentare permise server-side, separate prin virgulă. Modelele din config/app sunt incluse automat.
OPENROUTER_ALLOWED_MODELS=
GOOGLE_AI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
GRAMMAR_SERVICE_URL=https://your-languagetool.example/v2/check
APP_URL=http://localhost:3000
# Emailuri tranzacționale Mailjet. MAILJET_FROM_EMAIL trebuie validat în Mailjet.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=EnglezaAI
MAILJET_REPLY_TO=
# RevenueCat Admin API v2 — cheie secretă numai pe server, niciodată EXPO_PUBLIC_ / VITE_
REVENUECAT_PROJECT_ID=
REVENUECAT_V2_SECRET_KEY=
REVENUECAT_PRO_ENTITLEMENT_LOOKUP_KEY=englezaai_pro
# Activează verificarea server-side pe endpoint-urile AI după configurarea RevenueCat production
SUBSCRIPTION_ENFORCEMENT_ENABLED=false
# Necesare în producție pentru cote corecte între toate instanțele serverless.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Cotele zilnice se resetează în acest fus. Valorile de mai jos sunt implicite și pot fi ajustate.
QUOTA_TIME_ZONE=Europe/Bucharest
FREE_OPENROUTER_DAILY_LIMIT=50
FREE_TTS_DAILY_LIMIT=15
FREE_AZURE_DAILY_LIMIT=5
FREE_GRAMMAR_DAILY_LIMIT=30
PRO_OPENROUTER_DAILY_LIMIT=500
PRO_TTS_DAILY_LIMIT=300
PRO_AZURE_DAILY_LIMIT=100
PRO_GRAMMAR_DAILY_LIMIT=1000
# Opțional, numai dacă alegi providerul TTS OpenAI-compatibil
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
