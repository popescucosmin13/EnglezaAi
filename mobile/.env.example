# Copiază în .env și completează cu valorile reale (aceleași ca VITE_* din web).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
# URL-ul propriului backend de dezvoltare
EXPO_PUBLIC_API_BASE=http://localhost:3000

# RevenueCat Test Store pentru development/preview. În producție folosește cheia publică
# specifică magazinului: `goog_...` pentru Google Play și `appl_...` pentru Apple App Store.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=englezaai_pro
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=default
EXPO_PUBLIC_REVENUECAT_ALLOW_TEST_KEY=false
# Setat automat de profilurile EAS la development/preview/production.
EXPO_PUBLIC_APP_ENV=development
